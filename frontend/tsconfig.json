{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": { "mygo-runtime": ["./vendor/mygo-runtime/index.ts"] }
  },
  "include": ["src", "vendor"],
  // The tests run in bun (bun test), with its own types.
  "exclude": ["src/**/*.test.ts"]
}
