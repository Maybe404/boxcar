{
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 2080
    }
  ],
  "outbounds": [
    {
      "type": "vless",
      "tag": "香港",
      "server": "hk.example.com",
      "server_port": 443,
      "uuid": "00000000-0000-4000-8000-000000000001",
      "tls": {
        "enabled": true,
        "server_name": "hk.example.com"
      }
    },
    {
      "type": "hysteria2",
      "tag": "日本",
      "server": "jp.example.com",
      "server_port": 443,
      "password": "secret",
      "tls": {
        "enabled": true,
        "server_name": "jp.example.com"
      }
    },
    {
      "type": "selector",
      "tag": "proxy",
      "outbounds": [
        "香港",
        "日本"
      ]
    }
  ],
  "route": {
    "final": "proxy",
    "default_domain_resolver": "dns-local"
  },
  "dns": {
    "servers": [
      {
        "type": "local",
        "tag": "dns-local"
      },
      {
        "type": "fakeip",
        "tag": "fakeip",
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "fc00::/18"
      }
    ],
    "final": "dns-local",
    "rules": [
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "action": "route",
        "server": "fakeip"
      }
    ]
  }
}
